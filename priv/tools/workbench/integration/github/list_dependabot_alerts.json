{
  "type": "object",
  "description": "List dependency vulnerability alerts from Dependabot for a repository via GitHub REST.",
  "properties": {
    "owner": {
      "type": "string",
      "description": "Repository owner."
    },
    "repo": {
      "type": "string",
      "description": "Repository name."
    },
    "state": {
      "type": "string",
      "enum": ["auto_dismissed", "dismissed", "fixed", "open"],
      "description": "Filter alerts by state."
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"],
      "description": "Filter alerts by severity."
    },
    "ecosystem": {
      "type": "string",
      "description": "Filter by package ecosystem, such as npm, gomod, pip, or maven."
    },
    "package": {
      "type": "string",
      "description": "Filter by package name."
    },
    "manifest": {
      "type": "string",
      "description": "Filter by manifest path."
    },
    "scope": {
      "type": "string",
      "enum": ["development", "runtime"],
      "description": "Filter by dependency scope."
    },
    "sort": {
      "type": "string",
      "enum": ["created", "updated", "epss_percentage"],
      "description": "Sort field."
    },
    "direction": {
      "type": "string",
      "enum": ["asc", "desc"],
      "description": "Sort direction."
    },
    "page": {
      "type": "integer",
      "description": "Page number. Defaults to 1."
    },
    "per_page": {
      "type": "integer",
      "description": "Results per page. Defaults to 30."
    }
  },
  "required": ["owner", "repo"],
  "additionalProperties": false
}
