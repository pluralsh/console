{
    "type": "object",
    "properties": {
        "query": {
            "type": "string",
            "description": "The service name to search. Optional when filters.service is set."
        },
        "limit": {
            "type": "integer",
            "description": "Maximum number of traces to search. Not a hard limit, but the provider may impose a limit. Defaults to 100."
        },
        "options": {
            "type": "object",
            "description": "Legacy Jaeger options; prefer filters.",
            "properties": {
                "jaeger": {
                    "type": "object",
                    "description": "Structured Jaeger trace filters.",
                    "properties": {
                        "operation_name": {
                            "type": "string",
                            "description": "Jaeger operation/span name filter."
                        },
                        "duration_min": {
                            "type": "string",
                            "description": "Minimum span duration using protobuf duration format, e.g. `10ms`, `1.5s`."
                        },
                        "duration_max": {
                            "type": "string",
                            "description": "Maximum span duration using protobuf duration format, e.g. `500ms`, `10s`."
                        },
                        "attributes": {
                            "type": "array",
                            "description": "Dynamic Jaeger tag/attribute filters.",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "description": "Tag/attribute key"
                                    },
                                    "value": {
                                        "type": "string",
                                        "description": "Tag/attribute value"
                                    }
                                },
                                "required": [
                                    "name",
                                    "value"
                                ]
                            }
                        }
                    }
                }
            }
        },
        "time_range": {
            "type": "object",
            "properties": {
                "start": {
                    "type": "string",
                    "description": "The start time to use to filter traces. Provide in RFC3339 format, e.g. `2023-01-01T00:00:00Z`."
                },
                "end": {
                    "type": "string",
                    "description": "The end time to use to filter traces. Provide in RFC3339 format, e.g. `2023-01-01T00:00:00Z`."
                }
            }
        },
        "filters": {
            "type": "object",
            "description": "Structured filters, translated to the provider's query language. All set filters must match.",
            "properties": {
                "service": {
                    "type": "string",
                    "description": "Service name (`service.name`). Discover values with trace facets on `service.name`."
                },
                "operation": {
                    "type": "string",
                    "description": "Span (operation) name, e.g. `GET /api/orders`. Discover values with trace facets on `name`."
                },
                "attributes": {
                    "type": "array",
                    "description": "Exact-match span or resource attribute filters, e.g. `http.route` = `/orders` or `k8s.namespace.name` = `prod`.",
                    "items": {
                        "type": "object",
                        "properties": {
                            "name": {
                                "type": "string",
                                "description": "Attribute name"
                            },
                            "value": {
                                "type": "string",
                                "description": "Attribute value"
                            }
                        },
                        "required": [
                            "name",
                            "value"
                        ]
                    }
                },
                "duration_min": {
                    "type": "string",
                    "description": "Minimum span duration, e.g. `250ms` or `1.5s`."
                },
                "duration_max": {
                    "type": "string",
                    "description": "Maximum span duration, e.g. `10s`."
                },
                "errors_only": {
                    "type": "boolean",
                    "description": "Only match spans with an error status."
                },
                "trace_id": {
                    "type": "string",
                    "description": "Fetch one whole trace by id; other filters and the query are ignored."
                }
            }
        }
    },
    "required": [
        "time_range"
    ]
}
