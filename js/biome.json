{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true, "root": ".." },
  "files": {
    "includes": [
      "**",
      "!**/src/generated",
      "!documentation/src/routes/docs.generated.ts",
      "!documentation/src/routing/navigation.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "attributePosition": "multiline"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "es5",
      "semicolons": "asNeeded"
    }
  },
  "css": {
    "formatter": { "quoteStyle": "single" },
    "linter": { "enabled": false }
  },
  "linter": {
    "rules": {
      "preset": "none",
      "complexity": {
        "noArguments": "error",
        "noBannedTypes": "error",
        "noUselessThisAlias": "error",
        "noUselessTypeConstraint": "error"
      },
      "correctness": {
        "noChildrenProp": "error",
        "noReactPropAssignments": "error",
        "noRenderReturnValue": "error",
        "noUnusedFunctionParameters": "error",
        "noUnsafeOptionalChaining": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "security": {
        "noBlankTarget": "error",
        "noDangerouslySetInnerHtmlWithChildren": "error"
      },
      "style": {
        "noCommonJs": "error",
        "noNamespace": "error",
        "useArrayLiterals": "error",
        "useAsConstAssertion": "error",
        "useConst": "error",
        "useExportType": "error",
        "useSpreadOverApply": "error"
      },
      "suspicious": {
        "noCommentText": "error",
        "noDuplicateEnumValues": "error",
        "noDuplicateFields": "error",
        "noDuplicateJsxProps": "error",
        "noExtraNonNullAssertion": "error",
        "noMisleadingInstantiator": "error",
        "noNonNullAssertedOptionalChain": "error",
        "noReactForwardRef": "error",
        "noSelfCompare": "error",
        "noUnknownAttribute": {
          "level": "error",
          "options": { "ignore": ["css"] }
        },
        "noUnsafeDeclarationMerging": "error",
        "noUnusedExpressions": "error",
        "noVar": "error",
        "useNamespaceKeyword": "error"
      }
    }
  },
  "assist": { "enabled": false },
  "overrides": [
    {
      "includes": ["design-system/src/**/*.stories.{ts,tsx}"],
      "linter": { "enabled": false }
    },
    {
      "includes": ["stylelint-config/**"],
      "linter": { "rules": { "style": { "noCommonJs": "off" } } }
    },
    {
      "includes": ["documentation/**"],
      "linter": {
        "rules": {
          "a11y": {
            "preset": "recommended",
            "noLabelWithoutControl": {
              "level": "error",
              "options": {
                "labelComponents": ["Label"],
                "inputComponents": ["Input"]
              }
            }
          },
          "style": {
            "useImportType": "error"
          }
        }
      },
      "assist": {
        "enabled": true,
        "actions": {
          "source": {
            "organizeImports": {
              "level": "on",
              "options": {
                "groups": [
                  ":NODE:",
                  ["react", "react/**"],
                  ":BLANK_LINE:",
                  ["next", "next/**", "@pluralsh/design-system"],
                  ":BLANK_LINE:",
                  [":PACKAGE:", ":PACKAGE_WITH_PROTOCOL:", "!@src/**"],
                  ":BLANK_LINE:",
                  ["@src/**", ":ALIAS:", ":PATH:"]
                ]
              }
            }
          }
        }
      }
    }
  ]
}
