{
  "name": "console-workspace",
  "private": true,
  "workspaces": [
    "console",
    "design-system",
    "documentation"
  ],
  "scripts": {
    "lint": "biome check console/src design-system/src documentation/src documentation/pages && oxlint console/src design-system/src documentation/src documentation/pages",
    "lint:biome": "biome check console/src design-system/src documentation/src documentation/pages",
    "lint:oxlint": "oxlint console/src design-system/src documentation/src documentation/pages",
    "fix": "yarn lint:oxlint --fix && yarn lint:biome --write",
    "test": "yarn workspace console test && yarn workspace @pluralsh/design-system test"
  },
  "engines": {
    "node": "24.11.1"
  },
  "packageManager": "yarn@4.17.1",
  "resolutions": {
    "@types/react": "19.3.0",
    "brace-expansion@npm:^2.0.1": "2.1.4",
    "brace-expansion@npm:^2.0.2": "2.1.4",
    "dompurify": "3.4.13",
    "elkjs": "0.12.0",
    "fast-uri": "3.1.6",
    "js-yaml": "4.3.2",
    "immutable@npm:~3.7.6": "3.8.4",
    "postcss": "8.5.23",
    "shell-quote": "1.10.0",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "lint-staged": "17.6.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,graphql}": "biome format --write --no-errors-on-unmatched"
  }
}
