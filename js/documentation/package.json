{
  "name": "@pluralsh/documentation",
  "private": true,
  "engines": {
    "node": ">=24.11.1"
  },
  "scripts": {
    "dev": "run-s generate:route-index dev:next",
    "dev:next": "next dev -p 3004",
    "build": "run-s generate:route-index build:next",
    "build:next": "biome check --vcs-enabled=false ./src ./pages && next build",
    "start": "next start -p 3000",
    "lint": "run-p lint:biome lint:js",
    "lint:biome": "biome check ./src ./pages",
    "lint:js": "oxlint -c ../.oxlintrc.json src pages",
    "fix": "run-s fix:js fix:biome",
    "fix:biome": "biome check --write ./src ./pages",
    "fix:js": "oxlint -c ../.oxlintrc.json --fix src pages",
    "generate:route-index": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/index-routes.ts"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@apollo/client": "3.14.1",
    "@markdoc/markdoc": "0.5.10",
    "@markdoc/next.js": "0.5.0",
    "@mermaid-js/layout-elk": "0.2.2",
    "@open-draft/until": "2.1.0",
    "@pluralsh/design-system": "workspace:*",
    "@react-aria/ssr": "3.10.1",
    "@react-spring/web": "10.1.2",
    "@styra/highlightjs-rego": "0.1.2",
    "classnames": "2.5.1",
    "graphql": "16.14.2",
    "htmlparser2": "9.1.0",
    "immer": "10.2.0",
    "js-yaml": "4.3.2",
    "lodash": "4.18.1",
    "mermaid": "11.16.1",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-transition-group": "4.4.5",
    "react-use-measure": "2.1.7",
    "rooks": "7.14.1",
    "styled-components": "6.6.0",
    "swr": "2.5.1",
    "usehooks-ts": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "npm-run-all2": "9.0.3",
    "openapi-types": "12.1.3",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2"
  }
}
