{
  "name": "@pluralsh/documentation",
  "private": true,
  "engines": {
    "node": ">=24.11.1"
  },
  "scripts": {
    "dev": "run-s generate:route-index && concurrently \"next dev -p 3004\" \"yarn graphql:codegen:watch\"",
    "dev:watch": "concurrently \"next dev -p 3004\" \"yarn graphql:codegen:watch\"",
    "build": "run-s generate:route-index build:next",
    "build:next": "biome check --vcs-enabled=false ./src ./pages && next build",
    "start": "next start -p 3000",
    "lint": "run-p lint:biome lint:js",
    "lint:biome": "biome check ./src ./pages",
    "lint:js": "oxlint -c ../.oxlintrc.json src pages",
    "fix": "run-s fix:js fix:biome",
    "fix:biome": "biome check --write ./src ./pages",
    "fix:js": "oxlint -c ../.oxlintrc.json --fix src pages",
    "graphql:codegen": "graphql-codegen --config codegen.yml",
    "graphql:codegen:watch": "graphql-codegen --watch --config codegen.yml",
    "generate:route-index": "ts-node scripts/index-routes.ts"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@apollo/client": "3.14.1",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@graphql-codegen/cli": "4.0.1",
    "@graphql-codegen/introspection": "4.0.0",
    "@graphql-codegen/typescript": "4.0.0",
    "@graphql-codegen/typescript-operations": "4.0.0",
    "@graphql-codegen/typescript-react-apollo": "3.3.7",
    "@loomhq/loom-embed": "1.5.0",
    "@markdoc/markdoc": "0.4.0",
    "@markdoc/next.js": "0.2.2",
    "@mermaid-js/layout-elk": "0.2.2",
    "@open-draft/until": "2.1.0",
    "@pluralsh/design-system": "workspace:*",
    "@react-aria/ssr": "3.6.0",
    "@react-spring/web": "10.1.2",
    "@react-stately/list": "3.8.1",
    "@react-stately/select": "3.5.1",
    "@react-stately/selection": "3.19.0",
    "@styra/highlightjs-rego": "^0.1.2",
    "chroma-js": "2.6.0",
    "classnames": "2.5.1",
    "deep-freeze": "0.0.1",
    "fuse.js": "7.5.0",
    "graphql": "16.14.2",
    "gray-matter": "4.0.3",
    "htmlparser2": "9.1.0",
    "immer": "10.2.0",
    "js-yaml": "4.3.2",
    "lodash": "4.18.1",
    "memoize-one": "6.0.0",
    "mermaid": "11.16.1",
    "next": "15.5.24",
    "raw-loader": "4.0.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-github-btn": "1.4.0",
    "react-is": "18.2.0",
    "react-transition-group": "4.4.5",
    "react-use-measure": "2.1.7",
    "rooks": "7.14.1",
    "styled-components": "6.5.3",
    "swr": "2.1.5",
    "tslib": "2.5.3",
    "usehooks-ts": "2.9.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@graphql-codegen/cli": "4.0.1",
    "@graphql-codegen/client-preset": "4.0.0",
    "@types/glob": "8.1.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "babel-plugin-react-compiler": "1.0.0",
    "chokidar": "4.0.3",
    "concurrently": "8.2.0",
    "npm-run-all2": "9.0.3",
    "openapi-types": "12.1.3",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  }
}
