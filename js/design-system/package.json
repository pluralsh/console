{
  "name": "@pluralsh/design-system",
  "version": "0.2.0",
  "description": "Pluralsh Design System",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "start": "storybook dev -p 6006 --initial-path /story/icons--default",
    "build:storybook": "storybook build && yarn build:fix:storybook",
    "build:fix:storybook": "perl -pi -w -e 's/%40/@/g;' storybook-static/index.html",
    "chromatic": "chromatic --storybook-build-dir=storybook-static --exit-once-uploaded",
    "storybook:serve-static": "yarn build:storybook && http-server storybook-static",
    "build": "rimraf dist && vite build && tsc --build --force",
    "build:no-tsc": "rimraf dist && vite build",
    "build:watch": "rimraf dist && vite build --watch",
    "clean": "rimraf storybook-static dist",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "run-p lint:biome lint:js",
    "lint:biome": "biome check ./src",
    "lint:js": "oxlint -c ../.oxlintrc.json ./src",
    "fix": "run-s fix:js fix:biome",
    "fix:biome": "biome check --write ./src",
    "fix:js": "oxlint -c ../.oxlintrc.json --fix ./src",
    "prepublishOnly": "npm run build",
    "analyze": "vite-bundle-visualizer -o stats.html"
  },
  "engines": {
    "node": ">=24.11.1"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@floating-ui/react": "0.27.20",
    "@markdoc/markdoc": "0.4.0",
    "@mermaid-js/layout-elk": "0.2.2",
    "@monaco-editor/react": "4.7.0",
    "@radix-ui/react-accordion": "1.2.16",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-focus-scope": "1.1.12",
    "@react-aria/utils": "3.34.1",
    "@react-hooks-library/core": "0.6.2",
    "@react-spring/web": "10.1.2",
    "@react-stately/utils": "3.12.1",
    "@tanstack/match-sorter-utils": "8.19.4",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.6",
    "chroma-js": "2.6.0",
    "classnames": "2.5.1",
    "dayjs": "1.11.23",
    "elkjs": "0.12.0",
    "highlight.js": "11.11.1",
    "immer": "10.2.0",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "mermaid": "11.16.1",
    "react-animate-height": "3.2.4",
    "react-aria": "3.50.0",
    "react-diff-viewer-continued": "4.4.0",
    "react-markdown": "9.1.0",
    "react-merge-refs": "2.1.1",
    "react-stately": "3.48.0",
    "react-use-measure": "2.1.7",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "use-immer": "0.11.0"
  },
  "devDependencies": {
    "@apollo/client": "3.14.1",
    "@babel/core": "7.29.7",
    "@biomejs/biome": "2.5.15",
    "@react-stately/form": "3.3.1",
    "@react-types/listbox": "3.8.0",
    "@react-types/select": "3.13.0",
    "@react-types/shared": "3.36.1",
    "@react-types/tabs": "3.4.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-links": "10.6.0",
    "@storybook/builder-vite": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@testing-library/dom": "10.4.2",
    "@types/chroma-js": "2.4.5",
    "@types/d3": "7.4.3",
    "@types/lodash": "4.17.25",
    "@types/lodash-es": "4.17.12",
    "@types/react-transition-group": "4.4.12",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/ui": "5.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "babel-plugin-styled-components": "2.3.0",
    "chromatic": "18.5.0",
    "fuse.js": "7.5.0",
    "http-server": "14.1.1",
    "jsdom": "30.0.1",
    "monaco-editor": "0.55.1",
    "npm-run-all2": "9.0.3",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "react-router-dom": "7.18.4",
    "react-transition-group": "4.4.5",
    "rimraf": "5.0.10",
    "storybook": "10.6.0",
    "type-fest": "5.9.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-bundle-visualizer": "1.2.1",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "@apollo/client": ">=3.14.1",
    "react": ">=19.2.0",
    "react-dom": ">=19.2.0",
    "react-transition-group": ">=4.4.5",
    "styled-components": ">=6.2.0"
  }
}
