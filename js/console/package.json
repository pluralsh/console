    "lint-staged": "16.4.0",
    "npm-run-all2": "5.0.2",
    "prettier": "3.9.6",
    "stylelint": "15.11.0",
    "type-fest": "4.41.0",
    "typescript": "5.8.2",
    "vite": "7.3.6",
    "vite-bundle-visualizer": "1.2.1",
