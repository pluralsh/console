{
  "name": "@pluralsh/documentation",
  "private": true,
  "engines": {
    "node": ">=24.11.1"
  },
  "scripts": {
    "dev": "run-s generate:route-index && concurrently \"next dev -p 3004\" \"yarn graphql:codegen:watch\"",
    "dev:watch": "concurrently \"next dev -p 3004\" \"yarn graphql:codegen:watch\"",
    "build": "run-s generate:route-index build:next",
    "build:next": "next build",
    "start": "next start -p 3000",
    "lint": "run-p lint:format lint:js lint:css",
    "lint:format": "prettier --check --no-error-on-unmatched-pattern ./{src,pages}/**/*.{js,jsx,ts,tsx,graphql,md,mdpart}",
    "lint:js": "eslint {src,pages} --ext ts,tsx,js,jsx",
    "lint:css": "stylelint src/**/*.css",
    "fix": "run-s fix:format fix:js fix:css",
    "fix:format": "prettier --write --no-error-on-unmatched-pattern ./{src,pages}/**/*.{js,jsx,ts,tsx,graphql,md,mdpart}",
    "fix:js": "eslint --fix {src,pages} --ext ts,tsx,js,jsx",
    "fix:css": "stylelint src/**/*.css --fix",
    "graphql:codegen": "graphql-codegen --config codegen.yml",
    "graphql:codegen:watch": "graphql-codegen --watch --config codegen.yml",
    "generate:route-index": "ts-node scripts/index-routes.ts"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@apollo/client": "3.7.15",
    "@emotion/react": "11.11.1",
    "@emotion/styled": "11.11.0",
    "@graphql-codegen/add": "5.0.0",
    "@graphql-codegen/cli": "4.0.1",
    "@graphql-codegen/introspection": "4.0.0",
    "@graphql-codegen/typescript": "4.0.0",
    "@graphql-codegen/typescript-operations": "4.0.0",
    "@graphql-codegen/typescript-react-apollo": "3.3.7",
    "@loomhq/loom-embed": "1.5.0",
    "@markdoc/markdoc": "0.4.0",
    "@markdoc/next.js": "0.2.2",
    "@mermaid-js/layout-elk": "0.2.0",
    "@open-draft/until": "2.1.0",
    "@pluralsh/design-system": "workspace:*",
    "@react-aria/ssr": "3.6.0",
    "@react-spring/web": "10.1.2",
    "@react-stately/list": "3.8.1",
    "@react-stately/select": "3.5.1",
    "@react-stately/selection": "3.19.0",
    "@styra/highlightjs-rego": "^0.1.2",
    "chroma-js": "2.4.2",
    "classnames": "2.3.2",
    "deep-freeze": "0.0.1",
    "fuse.js": "6.6.2",
    "graphql": "16.6.0",
    "gray-matter": "4.0.3",
    "highlight.js": "11.9.0",
    "honorable": "1.0.0-beta.19",
    "honorable-theme-default": "1.0.0-beta.5",
    "htmlparser2": "9.1.0",
    "immer": "10.0.3",
    "js-yaml": "4.1.0",
    "lodash": "4.17.23",
    "memoize-one": "6.0.0",
    "mermaid": "11.12.1",
    "next": "15.5.24",
    "raw-loader": "4.0.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-embed": "3.7.0",
    "react-github-btn": "1.4.0",
    "react-is": "18.2.0",
    "react-transition-group": "4.4.5",
    "react-use-measure": "2.1.1",
    "rooks": "7.14.1",
    "styled-components": "6.2.0",
    "swr": "2.1.5",
    "tslib": "2.5.3",
    "usehooks-ts": "2.9.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "4.0.1",
    "@graphql-codegen/client-preset": "4.0.0",
    "@pluralsh/eslint-config-typescript": "2.5.183",
    "@pluralsh/stylelint-config": "2.0.10",
    "@types/glob": "8.1.0",
    "@types/node": "20.4.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "7.0.1",
    "@typescript-eslint/parser": "7.0.1",
    "chokidar": "4.0.3",
    "concurrently": "8.2.0",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.24",
    "eslint-config-prettier": "9.1.0",
    "eslint-import-resolver-typescript": "3.6.1",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-import-newlines": "1.3.4",
    "eslint-plugin-jsx-a11y": "6.8.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "7.33.2",
    "eslint-plugin-react-hooks": "4.6.0",
    "lint-staged": "13.2.2",
    "npm-run-all": "4.1.5",
    "openapi-types": "12.1.3",
    "prettier": "3.2.5",
    "react-hooks": "1.0.1",
    "stylelint": "15.10.1",
    "stylelint-config-prettier": "9.0.5",
    "ts-node": "10.9.2",
    "typescript": "5.3.3"
  },
  "packageManager": "yarn@4.17.1",
  "lint-staged": {
    "./{src,pages}/**/*.{js,jsx,ts,tsx,graphql,md,mdpart}": "prettier --write"
  }
}
