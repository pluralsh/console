<%= card do %>
  <%= h1 do %><%= @user.name %> shared a new secret <%= @share.name %><% end %>
  <%= p do %>Log Into the Plural Console to access the one-time download link for this secret.  It will no longer be viewable once consumed.<% end %>
<% end %>
<%= cta(href: url("/secrets/#{@share.handle}")) do %>View your secret<% end %>
