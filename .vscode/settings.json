{
  "eslint.workingDirectories": [
    { "directory": "./js/console", "changeProcessCWD": true },
    { "directory": "./js/design-system", "changeProcessCWD": true },
    { "directory": "./js/documentation", "changeProcessCWD": true }
  ],
  "files.associations": {
    "**/src/archive/**/*": "plaintext",
    "*.ejs": "handlebars",
    "*.mdpart": "markdoc"
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "[handlebars]": {
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false
  },
  "[javascript][javascriptreact][typescript][typescriptreact][json][jsonc][css][graphql]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.codeActionsOnSave": {
      "source.organizeImports.biome": "explicit"
    }
  },
  "biome.configurationPath": "./js/biome.json",
  "biome.lsp.bin": "./js/node_modules/.bin/biome",
  "editor.formatOnSave": true,
  "dotenv.enableAutocloaking": false,
  "git.ignoreLimitWarning": true
}
