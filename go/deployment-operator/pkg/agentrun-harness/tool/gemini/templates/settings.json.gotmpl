{
  "$schema": "https://raw.githubusercontent.com/google-gemini/gemini-cli/refs/heads/main/schemas/settings.schema.json",
  "base": {
    "modelConfig": {
      "generateContentConfig": {
        "temperature": 0.1
      }
    }
  },
  "context": {
    "fileName": "AGENTS.md"
  },
  "tools": {
    "core": {{ if eq .AgentRunMode "WRITE" }}[
    "read_file",
    "read_many_files",
    "write_file",
    "replace",
    "glob",
    "list_directory",
    "grep_search",
    "run_shell_command",
    "google_web_search",
    "web_fetch",
    "save_memory"
  ]{{ else }}[
    "read_file",
    "read_many_files",
    "glob",
    "list_directory",
    "grep_search",
    "run_shell_command(ls, cd, pwd, git status, git diff, git branch, git log, git show, git merge-base, git rev-parse, head, tail, cat, grep, rg, find)",
    "google_web_search",
    "save_memory"
  ]{{ end }},
    "shell": {
      "inactivityTimeout": {{ .InactivityTimeout }}
    }
  },
  "model": {
    "name": {{ quote .Model }}
  },
  "mcpServers": {
    "plural": {
      "httpUrl": "http://127.0.0.1:8080/mcp",
      "description": "Plural MCP Server",
      "trust": true
    },
    "codebase-memory-mcp": {
      "command": "/usr/local/bin/codebase-memory-mcp",
      "args": [],
      "env": {
        "CBM_CACHE_DIR": "/plural/.cache/codebase-memory-mcp"
      },
      "description": "Codebase Memory MCP Server for graph-backed code search",
      "trust": true
    }
  },
  "security": {
    "environmentVariableRedaction": {
      "enabled": true
    }
  },
  "privacy": {
    "usageStatisticsEnabled": false
  },
  "telemetry": {
    "enabled": false
  }
}
