#!/bin/sh
# /usr/bin/newuidmap and /usr/bin/newgidmap. Debian ships them setuid root, and a uid_map write needs CAP_SYS_ADMIN
# over the target user namespace unless the writer's euid owns it; Substrate never grants a box CAP_SYS_ADMIN, so as
# euid 0 they fail with EPERM. This runs shadow's own tool (unprivileged copies in this directory) as dev, which owns
# the namespaces rootless Podman creates, holding only the capabilities a mapping needs. dev's passwordless sudo is
# what reaches root here, so this grants dev nothing it doesn't already have.
set -eu
tool=$(basename "$0")
exec sudo -n setpriv --reuid="$(id -u)" --regid="$(id -g)" --init-groups \
  --inh-caps=+setuid,+setgid,+setfcap --ambient-caps=+setuid,+setgid,+setfcap \
  "/usr/local/libexec/devbox/${tool}" "$@"
