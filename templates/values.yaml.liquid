
ingress:
  console_dns: {{ configuration.consoleDns }}
  kas_dns: {{ configuration.kasDns }}
  {% if configuration.ingressClass %}
  ingressClass: {{ configuration.ingressClass }}
  {% endif %}
  {% if configuration.clusterIssuer %}
  annotations:
    cert-manager.io/cluster-issuer: {{ configuration.clusterIssuer }}
  {% endif %}

{% if configuration.provider %}
provider: {{ configuration.provider }}
{% endif %}

secrets:
  jwt: {{ configuration.jwt }}
  admin_name: {{ configuration.adminName }}
  aes_key: {{ configuration.aesKey }}
  erlang: {{ configuration.erlang }}
  admin_email: {{ configuration.adminEmail }}
  admin_password: {{ configuration.adminPassword }}
  cluster_name: {{ configuration.clusterName }}
  {% if configuration.pluralClientId %}
  plural_client_id: {{ configuration.pluralClientId }}
  {% endif %}
  {% if configuration.pluralClientSecret %}
  plural_client_secret: {{ configuration.pluralClientSecret }}
  {% endif %}
  {% if configuration.key %}
  key: "{{ configuration.key }}"
  {% endif %}
  {% if configuration.identity %}
  identity: "{{ configuration.identity }}"
  {% endif %}

extraSecretEnv:
  PLURAL_TOKEN: {{ configuration.pluralToken }}
  KAS_API_SECRET: {{ configuration.kasApi }}
  KAS_PRIVATE_API_SECRET: {{ configuration.kasPrivateApi }}
  KAS_REDIS_SECRET: {{ configuration.kasRedis }}
  POSTGRES_URL: {{ configuration.postgresUrl }}
  CONSOLE_BYOK: 'true'

kas:
  enabled: true
  consoleUrl: {{ configuration.consoleDns }}

  secrets:
    api: {{ configuration.kasApi }}
    privateapi: {{ configuration.kasPrivateApi }}
    redis: {{ configuration.kasRedis }}

  ingress:
    kas_dns: {{ configuration.kasDns }}
    {% if configuration.ingressClass %}
    ingressClass: {{ configuration.ingressClass }}
    {% endif %}
    {% if configuration.clusterIssuer %}
    annotations:
      cert-manager.io/cluster-issuer: {{ configuration.clusterIssuer }}
    {% endif %}

  redis:
    auth:
      password: {{ configuration.kasRedis }}

{% if imports.mgmt.console_s3_bucket %}
console:
  config:
    objectStore:
      provider: s3
      s3:
        bucket: {{ imports.mgmt.console_s3_bucket }}
        region: {{ imports.mgmt.console_s3_region }}
{% elsif imports.mgmt.console_azure_storage_account %}
{% if imports.mgmt.console_azure_client_id %}
serviceAccount:
  annotations:
    azure.workload.identity/client-id: {{ imports.mgmt.console_azure_client_id }}
podLabels:
  azure.workload.identity/use: "true"
{% endif %}
console:
  config:
    objectStore:
      provider: azure
      azure:
        storageAccount: {{ imports.mgmt.console_azure_storage_account }}
        container: {{ imports.mgmt.console_azure_container }}
        {% if imports.mgmt.console_azure_access_key %}
        accessKey: {{ imports.mgmt.console_azure_access_key }}
        {% endif %}
{% elsif imports.mgmt.console_gcs_bucket %}
{% if imports.mgmt.console_gcs_service_account %}
serviceAccount:
  annotations:
    iam.gke.io/gcp-service-account: {{ imports.mgmt.console_gcs_service_account }}
{% endif %}
console:
  config:
    objectStore:
      provider: gcs
      gcs:
        bucket: {{ imports.mgmt.console_gcs_bucket }}
        {% if imports.mgmt.console_gcs_credentials %}
        credentials: {{ imports.mgmt.console_gcs_credentials | json }}
        {% endif %}
{% endif %}
